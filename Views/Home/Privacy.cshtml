@{
    ViewData["Title"] = "Privacy Policy";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5>Virtual Event Ticketing System Privacy Policy</h5>
                <p>This is a student project for COMP2139 - Web Application Development at George Brown College.</p>
                
                <h6>Information Collection</h6>
                <p>We collect only the necessary information for ticket purchases:</p>
                <ul>
                    <li>Customer name</li>
                    <li>Email address</li>
                    <li>Event preferences and purchases</li>
                </ul>
                
                <h6>Data Usage</h6>
                <p>Your information is used solely for:</p>
                <ul>
                    <li>Processing ticket purchases</li>
                    <li>Sending purchase confirmations</li>
                    <li>Event management purposes</li>
                </ul>
                
                <h6>Data Protection</h6>
                <p>This application is for educational purposes and operates in a development environment.</p>
            </div>
        </div>
    </div>
</div>>