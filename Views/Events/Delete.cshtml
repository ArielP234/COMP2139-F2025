@model VirtualEventTicketing.Models.Event
@{
    ViewData["Title"] = "Delete Event";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Delete Event</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="alert alert-danger">
    <h4 class="alert-heading">Warning!</h4>
    <p class="mb-0">Are you sure you want to delete this event? This action cannot be undone.</p>
</div>

<div class="card">
    <div class="card-body">
        <h3>@Model.Title</h3>
        <div class="row mt-3">
            <div class="col-md-6">
                <strong>Category:</strong> @Model.Category?.Name<br>
                <strong>Date:</strong> @Model.Date.ToString("MMM dd, yyyy hh:mm tt")<br>
            </div>
            <div class="col-md-6">
                <strong>Ticket Price:</strong> 
                @if (Model.TicketPrice == 0)
                {
                    <span>FREE</span>
                }
                else
                {
                    <span>$@Model.TicketPrice</span>
                }<br>
                <strong>Available Tickets:</strong> @Model.AvailableTickets
            </div>
        </div>
        <p class="mt-3"><strong>Description:</strong> @Model.Description</p>
        
        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>