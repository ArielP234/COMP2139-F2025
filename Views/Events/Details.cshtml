@model VirtualEventTicketing.Models.Event
@{
    ViewData["Title"] = "Event Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Event Details</h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h2 class="card-title">@Model.Title</h2>
                <div class="mb-3">
                    <span class="badge bg-primary fs-6">@Model.Category?.Name</span>
                </div>
                <p class="card-text lead">@Model.Description</p>
                
                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <strong><i class="fas fa-calendar text-primary"></i> Date & Time:</strong><br>
                            @Model.Date.ToString("dddd, MMMM dd, yyyy 'at' hh:mm tt")
                        </div>
                        <div class="mb-3">
                            <strong><i class="fas fa-ticket-alt text-success"></i> Ticket Price:</strong><br>
                            @if (Model.TicketPrice == 0)
                            {
                                <span class="text-success fw-bold fs-5">FREE</span>
                            }
                            else
                            {
                                <span class="fw-bold fs-5">$@Model.TicketPrice</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <strong><i class="fas fa-users text-info"></i> Available Tickets:</strong><br>
                            <span class="fw-bold fs-5 @(Model.AvailableTickets == 0 ? "text-danger" : Model.AvailableTickets < 5 ? "text-warning" : "text-success")">
                                @Model.AvailableTickets
                            </span>
                            @if (Model.AvailableTickets == 0)
                            {
                                <span class="badge bg-danger ms-2">Sold Out</span>
                            }
                            else if (Model.AvailableTickets < 5)
                            {
                                <span class="badge bg-warning ms-2">Low Availability</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Event Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    @if (Model.AvailableTickets > 0)
                    {
                        <a asp-controller="Purchases" asp-action="Create" asp-route-eventId="@Model.Id" 
                           class="btn btn-success btn-lg">
                            <i class="fas fa-shopping-cart"></i> Purchase Tickets
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg" disabled>
                            <i class="fas fa-times-circle"></i> Sold Out
                        </button>
                    }
                    
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                        <i class="fas fa-edit"></i> Edit Event
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="fas fa-trash"></i> Delete Event
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>>