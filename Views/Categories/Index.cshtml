@model List<VirtualEventTicketing.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Event Categories</h1>
</div>

<div class="row">
    @foreach (var category in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@category.Name</h5>
                    <p class="card-text text-muted">@category.Description</p>
                    <p class="card-text">
                        <span class="badge bg-primary">@category.Events.Count events</span>
                    </p>
                </div>
                <div class="card-footer bg-transparent">
                    <a asp-controller="Events" asp-action="Index" asp-route-categoryId="@category.Id" 
                       class="btn btn-outline-primary btn-sm">
                        View Events
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
        <h3>No Categories Available</h3>
        <p class="text-muted">Categories will be created automatically when you run the application.</p>
    </div>
}