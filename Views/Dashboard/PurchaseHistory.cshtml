@model IEnumerable<VirtualEventTicketing.Models.Purchase>

@{
    ViewData["Title"] = "Purchase History";
}

<h2>Purchase History</h2>

@if (!Model.Any())
{
    <p>No purchases yet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Date</th>
            <th>Items</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.PurchaseDate.ToString("g")</td>
                <td>
                    @foreach (var item in p.PurchaseItems)
                    {
                        <div>@item.Event.Title (@item.Quantity)</div>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}