@{
    ViewData["Title"] = "Dashboard";
    var role = ViewBag.Role as string;
}

<h1>Dashboard</h1>
<p class="text-muted">You are logged in as: <strong>@role</strong></p>

<hr />

@if (role == "Admin")
{
    <div class="list-group">
        <a asp-action="MyEvents" class="list-group-item list-group-item-action">Manage All Events</a>
        <a asp-action="Analytics" class="list-group-item list-group-item-action">Analytics Dashboard</a>
        <a asp-action="PurchaseHistory" class="list-group-item list-group-item-action">All Purchase History</a>
    </div>
}
else if (role == "Organizer")
{
    <div class="list-group">
        <a asp-action="MyEvents" class="list-group-item list-group-item-action">My Events</a>
        <a asp-action="Analytics" class="list-group-item list-group-item-action">Analytics Dashboard</a>
    </div>
}
else
{
    <div class="list-group">
        <a asp-action="MyTickets" class="list-group-item list-group-item-action">My Tickets</a>
        <a asp-action="PurchaseHistory" class="list-group-item list-group-item-action">My Purchase History</a>
        <a asp-action="Profile" class="list-group-item list-group-item-action">My Profile</a>
    </div>
}