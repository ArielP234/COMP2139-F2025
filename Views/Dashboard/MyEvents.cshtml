@model IEnumerable<VirtualEventTicketing.Models.Event>

@{
    ViewData["Title"] = "My Events";
}

<h2>My Events</h2>

@if (!Model.Any())
{
    <p>You have not created any events yet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Category</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Title</td>
                <td>@e.Date.ToString("g")</td>
                <td>@e.Category?.Name</td>
            </tr>
        }
        </tbody>
    </table>
}